APP_ENV=production
APP_PORT=8080

DB_DRIVER=postgres
DATABASE_URL=postgres://ecommerce:ecommerce123@localhost:5432/ecommerce_db?sslmode=disable
DB_HOST=localhost
DB_PORT=5432
DB_USER=ecommerce
DB_PASSWORD=ecommerce123
DB_NAME=ecommerce_db
DB_SSLMODE=disable
SQLITE_PATH=./ecommerce.db

JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

PAYMENT_MOCK_BASE_URL=http://localhost:8080
SEED_DB=true

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
WEBHOOK_SECRET=change-me-webhook-secret-min-32-chars
